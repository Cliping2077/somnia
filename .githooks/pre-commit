#!/bin/sh
# Pre-commit gate: refuse the basic hygiene mistakes that forced a history rewrite once.
# - private captures (account/token screenshots) and authoring-only helpers
# - credentials or personal absolute paths in staged content
# - large files (GitHub rejects >100 MB; this repo keeps assets under 10 MB)

blocked=0

fail() {
  echo "pre-commit: $1" >&2
  blocked=1
}

for file in $(git diff --cached --name-only --diff-filter=ACM); do
  case "$file" in
    demo/edge-*.png|demo/token*.png|demo/*token*.png|demo/screenshot*.png)
      fail "private capture staged: $file (move it to private-assets/)"
      continue ;;
    scripts/cdp-token.mjs|scripts/push-api.*|scripts/push-incremental.*)
      fail "authoring-only helper staged: $file"
      continue ;;
    eval/locomo10.json|eval/longmemeval_s.json|eval/results.json)
      fail "dataset staged: $file (fetch it, do not commit it)"
      continue ;;
  esac
  size=$(wc -c < "$file" 2>/dev/null || echo 0)
  if [ "$size" -gt 10485760 ]; then
    fail "file larger than 10 MB: $file ($size bytes)"
  fi
  case "$file" in
    *.png|*.jpg|*.jpeg|*.gif|*.webp)
      # Images cannot be content-scanned reliably; require an explicit allowlist entry.
      if ! grep -qx "$file" .gitallowed-media 2>/dev/null; then
        fail "image staged without an allowlist entry: $file (add it to .gitallowed-media if it is safe)"
      fi
      ;;
    *)
      if grep -nIE 'ghp_[A-Za-z0-9]{20,}|sk-[A-Za-z0-9]{20,}|Bearer [A-Za-z0-9._-]{20,}|C:\\Users\\[^\\]+' "$file" >/dev/null 2>&1; then
        fail "credential or personal absolute path in: $file"
      fi
      ;;
  esac
done

if [ "$blocked" -ne 0 ]; then
  echo "pre-commit: commit refused. Fix the items above; --no-verify is not a fix." >&2
  exit 1
fi
exit 0

#!/bin/sh
set -eu

remote=$1
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_ref" in
    '(delete)') continue ;;
  esac
  case "$remote_oid" in
    *[!0]*) base=$remote_oid ;;
    *) base="refs/remotes/$remote/main" ;;
  esac
  if ! git merge-base --is-ancestor "$base" "$local_oid" 2>/dev/null; then
    echo 'Push blocked because the destination baseline is missing or would be overwritten.' >&2
    exit 1
  fi
  node scripts/publish-safety.mjs "$base" "$local_oid"
done

{
  "name": "dsh-plugin-sleep-memory",
  "version": "1.0.2",
  "description": "Somnia: sleep-stage long-term memory for AI agents — episodic buffer, dream rewrite, downscale, snapshots (DeepSeek Harness adapter)",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "memory",
    "agent-memory",
    "dreaming",
    "sleep",
    "llm"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "core.js",
    "consolidate.js",
    "file-memory.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-chat"]
    }
  }
}
